<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WeakKeyScanner</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Key/address derivation only. This app never constructs, signs, or
         broadcasts a transaction; see MISSION.md principle 2. -->
    <PackageReference Include="NBitcoin" Version="7.0.*" />
  </ItemGroup>

</Project>
